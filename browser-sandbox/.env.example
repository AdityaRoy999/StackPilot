# ─────────────────────────────────────────────────────────────
# StackPilot Browser Sandbox — Remote GPU Deployment Config
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# These variables are used by docker-compose.gpu.yml

# ─── Stream Configuration ───────────────────────────────────
STREAM_FPS=30
STREAM_MAX_FPS=60
STREAM_IDLE_FPS=8
STREAM_WIDTH=1280
STREAM_HEIGHT=720
STREAM_BITRATE=4000k

# ─── NVENC Control ──────────────────────────────────────────
# NVENC is used only after an actual encode succeeds; software forces libx264.
STREAM_ENCODER=auto
# Auto uses an exposed graphics device, otherwise CPU page rendering with
# SwiftShader reserved for WebGL. Software forces the latter rendering mode.
BROWSER_RENDERER=auto

# ─── AWS Deploy Script Config (used by deploy.sh) ──────────
# INSTANCE_TYPE=g4dn.xlarge
# REGION=us-east-1
# KEY_NAME=stackpilot-sandbox
