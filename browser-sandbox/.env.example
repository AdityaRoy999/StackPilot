# ─────────────────────────────────────────────────────────────
# StackPilot Browser Sandbox — Remote GPU Deployment Config
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# These variables are used by docker-compose.gpu.yml

# ─── Stream Configuration ───────────────────────────────────
STREAM_FPS=60
STREAM_WIDTH=1920
STREAM_HEIGHT=1080
STREAM_BITRATE=4000k

# ─── NVENC Control ──────────────────────────────────────────
# "auto" = auto-detect GPU, "true" = force NVENC, "false" = force libx264
USE_NVENC=auto

# ─── AWS Deploy Script Config (used by deploy.sh) ──────────
# INSTANCE_TYPE=g4dn.xlarge
# REGION=us-east-1
# KEY_NAME=stackpilot-sandbox
